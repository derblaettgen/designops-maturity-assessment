# Compose settings for the containerized deployment. On the VPS the real values
# live in /etc/designops/compose.env; for a local run copy this file to .env.
# Never commit real values.
# MONGO_PASSWORD ends up inside a connection URI: use only letters and digits.
MONGO_USER=designops
MONGO_PASSWORD=replace-with-a-long-random-alphanumeric-password
API_KEY=replace-with-a-long-random-maintenance-key
WEB_PORT=3103
API_PORT=3102
